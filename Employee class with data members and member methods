public class Employee {
    int id;
    String name;
    double salary;

    void display() {
        System.out.println("Employee ID: " + id);
        System.out.println("Employee Name: " + name);
        System.out.println("Employee Salary: " + salary);
    }

    public static void main(String[] args) {
        Employee emp = new Employee();

        emp.id = 101;
        emp.name = "Puneet";
        emp.salary = 250000;

        emp.display();
    }
}
